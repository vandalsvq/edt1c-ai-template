// Снятие таблицы Формат() 1С для конструктора макетов форм (tools/form-mockup).
//
// Запуск: консоль кода или «Вычислить» отладчика в любой базе на нужной версии платформы, русская
// локаль сеанса. Код линейный, без процедур: консоли исполняют текст через Выполнить(). В первой строке -
// путь к tools/form-mockup/tests/fixtures/format-1c.json: файл читается, у каждого случая значение
// форматируется Формат() самой 1С и пишется в expected, в source - версия платформы. Затем тест
// test_editor.FormatTest сверяет свой Формат() конструктора с этой таблицей.

ИмяФайла = "<путь к format-1c.json>";

Чтение = Новый ЧтениеJSON;
Чтение.ОткрытьФайл(ИмяФайла, "UTF-8");
Таблица = ПрочитатьJSON(Чтение, Ложь);
Чтение.Закрыть();

Для Каждого Случай Из Таблица.cases Цикл
	Если Случай.type = "date" Тогда
		Значение = ПрочитатьДатуJSON(Случай.value, ФорматДатыJSON.ISO);
	Иначе
		Значение = Случай.value;
	КонецЕсли;
	Случай.expected = Формат(Значение, Случай.format);
КонецЦикла;

СистемнаяИнформация = Новый СистемнаяИнформация;
Таблица.source = "Формат() 1С " + СистемнаяИнформация.ВерсияПриложения + ", локаль " + ТекущийКодЛокализации()
	+ ", снято " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy");

Запись = Новый ЗаписьJSON;
Запись.ОткрытьФайл(ИмяФайла, "UTF-8", Ложь, Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, " "));
ЗаписатьJSON(Запись, Таблица);
Запись.Закрыть();
Сообщить("Снято случаев: " + Таблица.cases.Количество());
