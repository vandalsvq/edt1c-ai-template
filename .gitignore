# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# EDT / Eclipse — только временное и генерируемое.
# ВНИМАНИЕ: `.project` и `.settings/` EDT-проекта коммитятся, их игнорировать нельзя.
.metadata/
bin/
tmp/
*.tmp
*.bak
*~.nib
local.properties
.loadpath
.recommenders
.target
*.launch
.factorypath

# 1С — файлы данных и временное.
# Артефакты сборки (*.cf, *.cfu, *.cfe, *.epf, *.erf, *.efd) НЕ игнорируются:
# готовые внешние обработки, отчёты и поставки расширений в репозитории уместны.
*.dt
1cv8.1CD
1Cv8Log/
*.1ccr

# IDE
.idea/
.vscode/
*.iml

# Claude Code локальные настройки
.claude/settings.local.json
.claude/projects/

# Машинно-специфичные конфиги (в репозитории — *.example-шаблоны)
.mcp.json

# Python (для скриптов)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Логи
*.log
logs/
